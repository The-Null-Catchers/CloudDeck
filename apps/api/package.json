    "@fastify/websocket": "^11.2.0",
    "argon2": "^0.44.0",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.3",
    "ws": "^8.22.0",
    "zod": "^4.1.12",
    "bullmq": "6.3.9",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/nodemailer": "^7.0.12",
